# curvtex language file (UTF-8).
#
# One file per language, placed in the "assets/lang" folder next to curvtex.exe. The file name (without ".lang") is the language code.
# To add a language: copy this file (en.lang), translate the values, and restart curvtex. No rebuild is needed.
# Entries you leave out fall back to the built-in English text.
#
# Header (all optional):
#   @name  = "..."   Name shown in the View > Language menu, written in that language itself.
#   @match = "..."   OS display-language tags (space separated, lower case) that select this language at startup.
#                    A tag matches exactly (zh-tw) or by its first part (pt matches pt-pt, pt-br ...).
#   @font  = "..."   Which font set to use: ja (default), zh, zh-hant, ko, th or latin.
#                    latin = Latin scripts that need extra accents (Vietnamese, Turkish, ...). ja also covers Cyrillic.
#   @order = N       Position in the menu (smaller comes first).
#
# Entries:  Key = "text"
#   Escapes: \\ (backslash)  \"  \n  \t  \uXXXX. Spaces inside the quotes are kept (some messages end with ": " on purpose).
#   printf specifiers (%u %zu %s %.4g %08X ...) must match the English text exactly, in the same order.
#   An entry whose specifiers differ, or whose key is unknown, is ignored (the problem is listed under View > Language).
#   Lines starting with # are comments.

@name  = "English"
@match = "en"
@font  = "ja"
@order = 20

